# Copia este archivo a .env y rellena los valores

# URL de conexión a PostgreSQL (Supabase)
# Formato: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# Secreto para firmar tokens JWT (usa algo largo y aleatorio)
# Genera uno en: https://randomkeygen.com
JWT_SECRET=cambia_esto_por_algo_muy_secreto_y_largo

# URL del frontend en Vercel (para CORS)
# Ejemplo: https://mi-app.vercel.app
FRONTEND_URL=https://TU-APP.vercel.app

# Puerto del servidor (Render lo asigna automáticamente, no tocar en producción)
PORT=3000

# Entorno
NODE_ENV=development
